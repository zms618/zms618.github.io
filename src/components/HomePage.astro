---
import { getSite, publicationGroups, type Lang } from '../data/site';
import { ui } from '../data/ui';
import PublicationCard from './PublicationCard.astro';
import Nav from './Nav.astro';
import SectionHeading from './SectionHeading.astro';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const site = getSite(lang);
const t = ui[lang];
const orderPublications = (ids: string[]) => ids
  .map(id => site.publications.find(pub => pub.public && pub.id === id))
  .filter((pub): pub is NonNullable<typeof pub> => Boolean(pub));
const firstAuthor = orderPublications(publicationGroups.firstAuthor);
const collaborative = orderPublications(publicationGroups.collaborative);
---
<Nav lang={lang} />
<main id="top">
  <section class="hero inner">
    <div class="hero-copy">
      <h1>{lang === 'zh' ? `${site.name} · Cheng He` : `${site.name} · 贺铖`}</h1>
      <p class="hero-identity">{site.heroIdentity}</p>
      <p class="tagline">{site.tagline}</p>
      <div class="hero-chips">
        {site.heroChips.map((chip) => <span>{chip}</span>)}
      </div>
      <div class="hero-actions">
        <a class="button primary" href="#publications">{t.publications} <span aria-hidden="true">↓</span></a>
        {site.cv && <a class="button ghost" href={site.cv}>{t.cv}</a>}
        {site.links.github && <a class="button ghost" href={site.links.github}>GitHub</a>}
        <a class="button ghost" href={`mailto:${site.email}`}>{t.email}</a>
      </div>
    </div>
    <aside class="hero-card">
      <div class:list={["portrait", { "has-image": site.avatar }]}>{site.avatar ? <img src={site.avatar} alt={site.name} /> : <span>{site.initials}</span>}</div>
      <p><strong>{site.role}, {site.affiliation}</strong></p>
      <small>{t.advisor}: <a class="text-link" href={site.advisor.href}>{site.advisor.name} ↗</a></small>
    </aside>
  </section>

  <section id="research" class="section inner">
    <SectionHeading kicker={t.research} title={t.questions} />
    <div class="research-grid">
      {site.research.map((item) => (
        <article class="research-card">
          <span class="index">{item.index}</span>
          <h3>{item.title}</h3>
          <p class="research-question">{item.question}</p>
          <p>{item.description}</p>
          <div class="tags">{item.tags.map((tag) => <span>{tag}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section id="publications" class="section section-tinted">
    <div class="inner">
      <SectionHeading kicker={t.publications} title={t.selected} />
      <div class="publication-list">{firstAuthor.map(pub => <PublicationCard publication={pub} lang={lang} />)}</div>
      <h3 class="subheading">{t.collaborative}</h3>
      <div class="publication-list">{collaborative.map(pub => <PublicationCard publication={pub} lang={lang} />)}</div>
    </div>
  </section>

  <section id="why-phd" class="why-phd section-tinted">
    <div class="inner why-phd-inner">
      <span class="kicker">{lang === 'zh' ? '研究方向' : 'Future Research'}</span>
      <div class="why-phd-copy">
        <h2>{site.whyPhd.title}</h2>
        <blockquote>{site.whyPhd.lead}</blockquote>
        {site.whyPhd.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section id="projects" class="section inner">
    <SectionHeading kicker={t.projects} title={t.work} />
    <div class="project-list">
      {site.projects.map((project) => (
        <article class="project-card">
          <div class="project-head">
            <div>
              <span class="eyebrow">{project.eyebrow}</span>
              <h3>{project.title}</h3>
            </div>
            <span class="date">{project.date}</span>
          </div>
          <div class="project-metrics">{project.metrics.map((metric) => <span>{metric}</span>)}</div>
          <div class="project-story">
            <div><span>{t.problem}</span><p>{project.problem}</p></div>
            <div><span>{t.approach}</span><p>{project.approach}</p></div>
          </div>
          <div class="project-outcome"><span>{t.outcome}</span><p>{project.outcome}</p></div>
          <div class="project-results" aria-label={t.outcome}>
            {project.resultMetrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
          </div>
          <div class="project-clinical"><span>{t.clinicalValue}</span><p>{project.clinicalValue}</p></div>
          {project.link && <a class="text-link" href={project.link}>{t.projectLink}</a>}
        </article>
      ))}
    </div>
  </section>

  <section id="about" class="section section-tinted">
    <div class="inner about-grid">
      <div>
        <SectionHeading kicker={t.about} title={t.background} />
        <p class="about-bio">{site.about.bio}</p>
        <div class="education">
          <h3>{t.education}</h3>
          {site.about.education.map((edu) => (
            <article>
              <div><strong>{edu.school}</strong><span>{edu.degree}</span></div>
              <time>{edu.date}</time>
              <p>{edu.detail}</p>
            </article>
          ))}
        </div>
      </div>
      <aside class="about-side">
        <div>
          <h3>{t.awards}</h3>
          <ul>{site.about.awards.map((award) => <li>{award}</li>)}</ul>
        </div>
      </aside>
    </div>
  </section>

  <section id="capabilities" class="section inner">
    <SectionHeading kicker={t.capabilities} title={t.capabilityTitle} />
    <div class="capability-grid">
      {site.capabilities.map((group) => (
        <article class="capability-card">
          <h3>{group.group}</h3>
          <div class="tags">{group.items.map((item) => <span>{item}</span>)}</div>
          <p>{group.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="contact inner">
    <span class="kicker">{t.contact}</span>
    <h2>{site.contact.title}</h2>
    <p class="contact-description">{site.contact.prefix} <strong>{site.contact.emphasis}</strong>{lang === 'zh' ? '。' : '. '}{site.contact.suffix}</p>
    <div class="contact-actions">
      <a class="button primary" href={`mailto:${site.email}`}>{t.email}</a>
      {site.links.github && <a class="button ghost" href={site.links.github}>GitHub</a>}
      {site.cv && <a class="button ghost" href={site.cv}>{t.cv}</a>}
    </div>
  </section>
</main>
<footer>
  <div class="inner footer-inner">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span>Built with Astro · <a href="#top">{t.top}</a></span>
  </div>
</footer>
